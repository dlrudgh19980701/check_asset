# Example environment variables for local development
# Copy this file to `.env` and fill in real values (keep secrets out of git).

# PostgreSQL connection URL format:
# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/postgres

# Optional: set Flask environment/host/port
#FLASK_ENV=development
#FLASK_APP=app.py
#PORT=5000
